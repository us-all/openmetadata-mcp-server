{
  "name": "@us-all/openmetadata-mcp",
  "version": "1.16.3",
  "mcpName": "io.github.us-all/openmetadata",
  "description": "OpenMetadata MCP server - metadata management, lineage, search, data quality, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openmetadata-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/ui','dist/ui',{recursive:true})\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "presmoke": "pnpm run build",
    "smoke": "node scripts/smoke-test.mjs",
    "pretoken-stats": "pnpm run build",
    "token-stats": "node scripts/measure-tokens.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@us-all/mcp-toolkit": "^1.2.3",
    "dotenv": "^17.4.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "hono": "^4.12.18",
      "fast-uri": "^3.1.2",
      "ip-address": "^10.1.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/us-all/openmetadata-mcp-server"
  },
  "homepage": "https://github.com/us-all/openmetadata-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/us-all/openmetadata-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openmetadata",
    "metadata",
    "lineage",
    "data-quality"
  ],
  "license": "MIT"
}
